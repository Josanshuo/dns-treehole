{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dns-treehole",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // 站点域名。deploy 时 Cloudflare 自动建 DNS 记录和证书。
  // 用 zone 下一级的名字最稳（Universal SSL 只覆盖一级子域）；也别放在 BASE_NAME（t.dnor.org）底下。
  "routes": [{ "pattern": "shudong.dnor.org", "custom_domain": true }],

  // 静态前端。免费版可用。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 找不到的路径返回 public/404.html（状态码 404）
    "not_found_handling": "404-page"
  },

  // 非机密配置。机密（CF_API_TOKEN、INVITE_CODES）用 wrangler secret put。
  "vars": {
    // 所有帖子挂在这个名字下面。建议单独一个域名，别和正经业务共用 zone。
    "BASE_NAME": "t.dnor.org",
    // 记录 comment 的前缀，用来把本项目的记录和 zone 里其他记录隔开
    "RECORD_TAG": "treehole",
    // 记录数上限。免费版 zone（2024-09-01 后新建）总共只有 200 条，这里留缓冲。
    "RECORD_CAP": "180",
    // 每轮对账最多删多少条，防止烧光 1200/5min 的 API 额度
    "SWEEP_BUDGET": "40"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "POST_REAPER",
        "class_name": "PostReaper"
      },
      {
        // 全站唯一实例，把「计数 → 腾位 → 建记录」串行化，并发发帖不会冲过上限
        "name": "POST_GATE",
        "class_name": "PostGate"
      }
    ]
  },

  // 免费版只能用 SQLite 存储后端的 DO
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PostReaper"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PostGate"]
    }
  ],

  // 免费版每账号最多 5 个 cron 触发器，最细到每分钟
  "triggers": {
    "crons": ["* * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
